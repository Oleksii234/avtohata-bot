# Скопируй этот файл в .env и заполни своими значениями

# Токен от @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ID таблицы: часть ссылки между /d/ и /edit
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Telegram ID того, кому приходят заявки (пока твой, потом папин).
# Узнать: напиши боту /start — он покажет ID
ADMIN_ID=0

# 1 — админ отвечает клиенту кнопками (цена/наличие) и у клиента есть «Мої заявки».
# 0 — простой режим: админу приходит заявка с телефоном, он сам звонит клиенту.
ADMIN_REPLIES=0

# Путь к ключу сервисного аккаунта Google
GOOGLE_CREDENTIALS=credentials.json
